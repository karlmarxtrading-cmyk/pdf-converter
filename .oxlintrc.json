{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-control-regex": "off",
    "unicorn/no-useless-spread": "off",
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrors": "none"
      }
    ]
  },
  "ignorePatterns": [
    "dist/**",
    "dist-qa/**",
    "node_modules/**",
    "evidence/**",
    "release/**"
  ]
}