{
  "name": "paperforma",
  "version": "3.0.0-rc.3",
  "private": true,
  "type": "module",
  "description": "PaperForma \u2014 studio dokumen statis: materi Markdown/teks/percakapan diolah di browser menjadi HTML dan cetak PDF lewat dialog cetak browser. Tanpa akun, tanpa harga, tanpa backend.",
  "engines": {
    "node": "24.22.3",
    "npm": ">=11.6.0 <12"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build.mjs",
    "build:qa": "node scripts/build.mjs --qa",
    "preview": "node scripts/serve-dist.mjs dist 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify:static": "node scripts/verify-static-release.mjs dist",
    "test:e2e": "node tests/e2e/run-e2e.mjs",
    "test:smoke": "node tests/e2e/static-smoke.mjs",
    "sbom": "node scripts/sbom.mjs",
    "scan:secrets": "node scripts/secret-scan.mjs",
    "test:gate": "node tests/e2e/release-gate.mjs",
    "lint": "oxlint -c .oxlintrc.json --deny-warnings src tests scripts",
    "test:pdf": "node tests/e2e/pdf-verify.mjs",
    "test:browsers": "node tests/e2e/cross-browser.mjs",
    "test:perf": "node tests/e2e/perf-matrix.mjs",
    "verify:deployment": "node scripts/verify-deployment-math.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "axe-core": "^4.14.1",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^31.0.1",
    "oxlint": "^1.94.0",
    "pdf-lib": "^1.17.1",
    "puppeteer-core": "^25.17.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.8",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.1",
    "diff": "^9.0.0",
    "dompurify": "^3.4.18",
    "fflate": "^0.8.3",
    "hast-util-to-mdast": "^10.1.4",
    "hast-util-to-text": "^4.0.3",
    "highlight.js": "^11.12.0",
    "idb": "^8.0.4",
    "katex": "^0.19.1",
    "mdast-util-to-hast": "^13.2.2",
    "mermaid": "^12.3.0",
    "pagedjs": "^0.4.3",
    "rehype-parse": "^9.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-remark": "^10.0.1",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remark-stringify": "^11.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0"
  },
  "overrides": {
    "katex": "$katex"
  },
  "packageManager": "npm@11.9.0"
}
